# Copy to .env and fill in. Everything has a dev default; production needs the marked ones.

# --- database
DB_USERNAME=woodstar
DB_PASSWORD=woodstar            # PROD: change

# --- app
SPRING_PROFILES_ACTIVE=dev      # PROD: prod (no demo seed, fake payments disabled)
PUBLIC_BASE_URL=http://localhost:3000   # PROD: https://puukapp.ee
DOMAIN=puukapp.ee               # PROD: used by Caddy for TLS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin            # PROD: change (seeded only when admin table is empty)
PICKUP_DEADLINE_HOURS=48

# --- payments: none (sales closed) | fake (dev only, refused with prod) | maksekeskus
PAYMENTS_PROVIDER=fake          # PROD: set by ops/deploy.sh (maksekeskus when keys exist, else none)
MAKSEKESKUS_SHOP_ID=
MAKSEKESKUS_SECRET_KEY=
MAKSEKESKUS_BASE_URL=https://api.maksekeskus.ee/v1   # test env: https://api.test.maksekeskus.ee/v1

# --- MQTT broker (Shelly devices + backend)
MQTT_ENABLED=true
MQTT_USERNAME=backend
MQTT_PASSWORD=backend           # PROD: change, and regenerate the password file (see docs/SHELLY.md)
MQTT_PASSWD_FILE=./infra/mosquitto/passwd.dev   # PROD: ./infra/mosquitto/passwd

# --- email (empty SMTP_HOST = emails are only logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@puukapp.ee
